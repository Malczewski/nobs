# Copy to scripts/deploy.env and fill in. Sourced by provision_vm.sh / deploy.sh.
GCP_PROJECT="my-gcp-project"

# --- GCP Always Free tier constraints (do not change unless you accept charges) ---
# The free e2-micro is ONLY free in: us-west1, us-central1, us-east1.
GCP_ZONE="us-central1-a"
MACHINE_TYPE="e2-micro"          # 2 vCPU (shared/burst), 1 GB RAM — the free shape
# Boot disk MUST be standard PD (pd-standard) and <= 30 GB to stay in the free tier.
# 10 GB is plenty for a slim image + SQLite; bump toward 30 GB (still free) if needed.
DISK_TYPE="pd-standard"
DISK_SIZE="10GB"

# Service account email the VM runs as (needs roles/storage.objectViewer on the
# config bucket). Leave blank to use the project's default compute SA.
SERVICE_ACCOUNT=""
# GCS bucket holding config.yaml (created by provision_vm.sh if missing).
# Keep it in the same region as the VM to avoid cross-region egress charges.
GCS_BUCKET_NAME="nobs-config-bucket"
