# Copy to .env and fill in. NEVER commit the real .env.

# --- Telegram bot (posts digests + forwards kept messages) ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Destination channel for BOTH digests and forwarded posts.
# Use the numeric -100... id or @channelusername (bot must be an admin).
TELEGRAM_CHANNEL_ID=-1001234567890

# --- Telegram user account (Telethon / MTProto) for reading channels ---
# From https://my.telegram.org/apps
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789
TELEGRAM_PHONE=+380XXXXXXXXX
# Generate once with: python scripts/generate_session.py
TELEGRAM_SESSION_STRING=
# Channel the monitor watches (numeric id, @username, or t.me link). Fixed.
TELEGRAM_SOURCE_CHANNEL=@some_source_channel

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key

# --- GCS config ---
GCS_BUCKET_NAME=nobs-config-bucket
GCS_CONFIG_PATH=config.yaml
# How long (seconds) to cache the GCS config before re-reading. 0 = always fresh.
CONFIG_TTL_SECONDS=60

# Path to a service account JSON key (mounted into the container at /secrets).
# Leave EMPTY on a GCP VM to use the attached service account automatically.
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json

# Local SQLite path (inside container; backed by a docker volume).
DB_PATH=/data/nobs.db
